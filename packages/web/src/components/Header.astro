---
import LogoMark from '@/components/LogoMark.astro'
import { withBase } from '@/lib/with-base'

const { currentPath = '/' } = Astro.props
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={withBase('/')} class="site-brand" aria-label="Skill Organizer home">
      <LogoMark className="h-9 w-auto" />
      <span>Skill Organizer</span>
    </a>
    <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Menu ☰</button>
    <nav id="site-navigation" class="site-navigation" aria-label="Main navigation">
      <a href={withBase('/docs')} aria-current={currentPath.startsWith('/docs') ? 'page' : undefined}>Docs</a>
      <a href={withBase('/#features')}>Features</a>
      <a href={withBase('/#install-flow')}>Install</a>
      <a href="https://github.com/sergiocarracedo/skill-organizer" target="_blank" rel="noreferrer">GitHub ↗</a>
      <a class="site-start" href={withBase('/docs/guides/install-and-verify')}>Get started →</a>
      <button class="site-theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">◐</button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-menu-toggle')
  const nav = document.querySelector<HTMLElement>('.site-navigation')
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true'
    toggle.setAttribute('aria-expanded', String(open))
    nav?.toggleAttribute('data-open', open)
  })

  const theme = document.querySelector<HTMLButtonElement>('.site-theme-toggle')
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')
  const system = matchMedia('(prefers-color-scheme: dark)')
  const updateLabel = () => {
    const current = meta?.content === 'dark' || (meta?.content === 'light dark' && system.matches) ? 'dark' : 'light'
    theme?.setAttribute('aria-label', `Switch to ${current === 'dark' ? 'light' : 'dark'} theme`)
  }
  theme?.addEventListener('click', () => {
    if (!meta) return
    const current = meta.content === 'dark' || (meta.content === 'light dark' && system.matches) ? 'dark' : 'light'
    const next = current === 'dark' ? 'light' : 'dark'
    const value = next === (system.matches ? 'dark' : 'light') ? 'light dark' : next
    meta.content = value
    try {
      if (value === 'light dark') localStorage.removeItem('color-scheme')
      else localStorage.setItem('color-scheme', value)
    } catch { /* The selection still applies for this page. */ }
    updateLabel()
  })
  system.addEventListener('change', updateLabel)
  window.addEventListener('storage', (event) => {
    if (event.key === 'color-scheme' && meta) meta.content = event.newValue === 'dark' || event.newValue === 'light' ? event.newValue : 'light dark'
    updateLabel()
  })
  updateLabel()
</script>
